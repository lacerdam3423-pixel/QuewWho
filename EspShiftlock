-- =====================================================================
-- DETECÇÃO DE INVENTÁRIO (COM CACHE)
-- =====================================================================
local roleCache = {}
local function GetPlayerRole(player)
    if roleCache[player] and tick() - roleCache[player].time < 0.5 then
        return table.unpack(roleCache[player].data)
    end
    local hasKnife, hasGun, activeWeapon, distance = false, false, "Nenhuma", 0
    pcall(function()
        local function scanContainer(container)
            if not container then return end
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local name = item.Name:lower()
                    if name:find("knife") or name:find("faca") or name:find("blade") or name:find("murder") or name:find("sword") then
                        hasKnife = true; activeWeapon = item.Name
                    elseif name:find("gun") or name:find("revolver") or name:find("pistol") or name:find("sheriff") or name:find("rifle") then
                        hasGun = true; activeWeapon = item.Name
                    end
                end
            end
        end
        scanContainer(player:FindFirstChildOfClass("Backpack"))
        scanContainer(player.Character)
        
        local lChar, tChar = LocalPlayer.Character, player.Character
        if lChar and tChar then
            local lHRP, tHRP = lChar:FindFirstChild("HumanoidRootPart"), tChar:FindFirstChild("HumanoidRootPart")
            if lHRP and tHRP then distance = math.floor((lHRP.Position - tHRP.Position).Magnitude) end
        end
    end)
    
    local roleData = hasKnife and {"Murderer", Color3.fromRGB(255, 35, 35), activeWeapon, distance} or 
                     (hasGun and {"Sheriff", Color3.fromRGB(30, 144, 255), activeWeapon, distance} or 
                     {"Inocente", Color3.fromRGB(0, 230, 120), "Nenhuma", distance})
    roleCache[player] = {data = roleData, time = tick()}
    return table.unpack(roleData)
end

