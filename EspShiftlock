local playerEspData = {}
local function cleanupPlayerEsp(player)
    local data = playerEspData[player]
    if data then
        if data.renderConnection then data.renderConnection:Disconnect() end
        if data.highlight then data.highlight:Destroy() end
        if data.bgui then data.bgui:Destroy() end
        if data.tracerLine then data.tracerLine:Destroy() end
        playerEspData[player] = nil
    end
    roleCache[player] = nil
end

local function setupPlayerEsp(player)
    if player == LocalPlayer then return end
    local function onCharacterAdded(character)
        cleanupPlayerEsp(player)
        local head = character:WaitForChild("Head", 5)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not head or not humanoid then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Outline"; highlight.FillTransparency = 0.8; highlight.OutlineTransparency = 0.1
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; highlight.Adornee = character; highlight.Parent = ScreenGui

        local bgui = Instance.new("BillboardGui")
        bgui.Name = "ESP_NameTag"; bgui.Adornee = head; bgui.Size = UDim2.new(0, 200, 0, 75)
        bgui.StudsOffset = Vector3.new(0, 3.0, 0); bgui.AlwaysOnTop = true; bgui.Parent = ScreenGui

        local label = Instance.new("TextLabel", bgui)
        label.Name = "NameLabel"; label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255); label.TextStrokeTransparency = 0.2; label.TextSize = 13; label.Font = Enum.Font.FredokaOne

        local tracerLine = Instance.new("Frame", TracersFolder)
        tracerLine.Name = "Tracer_" .. player.Name; tracerLine.AnchorPoint = Vector2.new(0.5, 0.5); tracerLine.BorderSizePixel = 0
        tracerLine.BackgroundColor3 = Color3.fromRGB(0, 255, 150); tracerLine.Visible = false

        playerEspData[player] = {highlight = highlight, bgui = bgui, label = label, tracerLine = tracerLine, character = character, humanoid = humanoid}

        local renderConnection
        renderConnection = RunService.RenderStepped:Connect(function()
            if not character or not character.Parent or humanoid.Health <= 0 then
                highlight.Enabled = false; bgui.Enabled = false; tracerLine.Visible = false; return
            end
            local anyEspActive = Config.EspOutlineActive or Config.EspNameActive or Config.EspRoleActive or Config.EspTimeActive or Config.EspHealthTextActive or Config.EspTracersActive or Config.EspStudsActive
            if not anyEspActive then highlight.Enabled = false; bgui.Enabled = false; tracerLine.Visible = false; return end

            local roleTitle, roleColor, activeWeapon, distance = GetPlayerRole(player)
            local currentTargetColor = Config.EspRainbowActive and Color3.fromHSV((os.clock() * 1.5) % 1, 1, 1) or (Config.EspRoleActive and roleColor or (Config.EspTimeActive and player.Team and player.TeamColor.Color or Color3.fromRGB(0, 255, 150)))

            highlight.Enabled = Config.EspOutlineActive; highlight.OutlineColor = currentTargetColor; highlight.FillColor = currentTargetColor

            if Config.EspNameActive or Config.EspRoleActive or Config.EspTimeActive or Config.EspHealthTextActive or Config.EspStudsActive then
                bgui.Enabled = true
                local textStr = ""
                if Config.EspNameActive then textStr = textStr .. "@" .. player.Name .. "\n" end
                if Config.EspRoleActive then textStr = textStr .. "[" .. roleTitle .. "]\n" .. (activeWeapon ~= "Nenhuma" and "Arma: " .. activeWeapon .. "\n" or "") end
                if Config.EspTimeActive then textStr = textStr .. "Time: " .. (player.Team and player.Team.Name or "Sem Time") .. "\n" end
                if Config.EspHealthTextActive then textStr = textStr .. "HP: " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. "\n" end
                if Config.EspStudsActive then textStr = textStr .. distance .. " studs" end
                label.Text = textStr; label.TextColor3 = currentTargetColor
            else
                bgui.Enabled = false
            end

            local hrp = character:FindFirstChild("HumanoidRootPart")
            if Config.EspTracersActive and hrp then
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    local targetPos = Vector2.new(vector.X, vector.Y)
                    local dist = (targetPos - screenCenter).Magnitude
                    tracerLine.Size = UDim2.new(0, dist, 0, 1.5)
                    tracerLine.Position = UDim2.new(0, (screenCenter.X + targetPos.X) / 2, 0, (screenCenter.Y + targetPos.Y) / 2)
                    tracerLine.Rotation = math.deg(math.atan2(targetPos.Y - screenCenter.Y, targetPos.X - screenCenter.X))
                    tracerLine.BackgroundColor3 = currentTargetColor; tracerLine.Visible = true
                else
                    tracerLine.Visible = false
                end
            else
                tracerLine.Visible = false
            end
        end)
        playerEspData[player].renderConnection = renderConnection
    end
    if player.Character then task.spawn(onCharacterAdded, player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayerEsp(p) end
Players.PlayerAdded:Connect(setupPlayerEsp)
Players.PlayerRemoving:Connect(cleanupPlayerEsp)

