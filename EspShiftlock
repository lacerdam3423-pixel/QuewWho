    activeBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    inactiveBtn1.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    inactiveBtn2.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    inactiveBtn3.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
end

